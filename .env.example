# Infra admin role only. Each app creates its own database and schema.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

CHATME_DIST=C:/Users/User/PortfolioProjects/ChatRoom/reactChatRoom/dist
TASKS_DIST=C:/Users/User/PortfolioProjects/TaskManager/TaskManagerReact/dist
FITCORE_DIST=C:/Users/User/FitCore.Client/build/web
ASTIBOSOFT_DIST=C:/Users/User/OneDrive/Десктоп/Asibo-Solutions/out
ASTIBOSOFT_ADMIN_DIST=C:/Users/User/Astibosoft.Admin.Client/build/web
# One folder per company. Each folder is that site's dist, not a nested dist/.
# On the VPS this is a Linux path, for example /var/www/previews.
PREVIEWS_DIST=C:/Users/User/infra/previews

# TLS: Compose mounts /etc/letsencrypt from the VPS (certbot).
# Astibosoft: / → marketing, /admin/ → Flutter admin, /api/ → astibosoft-api:8080
#             /preview/<company>/ → that company's dist

